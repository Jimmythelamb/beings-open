# Copy these into Netlify > Site configuration > Environment variables (never commit real values).
# Long random secret the scanner app/CLI sends as "Authorization: Bearer <token>". At least 24 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCANNER_UPLOAD_TOKEN=

# Optional (defaults shown)
# RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# Current ballot-pool contracts (Coston2, deploy block 37873904). Setting any of these REPLACES the
# default. Leave them unset unless this site should read a different deployment.
# LEDGER_ADDRESS=0x5d00bE9A32DcF1FcDe9475C8Be874aE8af0fCf0b
# REGISTRY_ADDRESS=0x9Ae01EEAf38FB03554970cbDC7F83FFBB8d4Ee8A
# MAX_IMAGE_BYTES=5000000
# MAX_RETENTION_DAYS=365
# ALLOWED_ORIGINS=https://beingsvote.live

# Verifier bulk access (GET /api/verifier/images). Verifiers sign a challenge with their wallet key; the key never
# leaves the verifier's machine.
# Verification is open: any address registered in the VerifierRegistry may bulk-download (signed requests from
# registered verifiers; the rate limit and the registration gas cost deter abuse). Nothing needs to be set.
# registry (default) | allowlist | either
# VERIFIER_AUTH_MODE=registry
# Optional: addresses for "allowlist"/"either" mode, comma/space/newline separated (0x + 40 hex).
# In "allowlist" mode an empty list answers 503.
# VERIFIER_ADDRESSES=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222
# VERIFIER_REGISTRY_ADDRESS=0x360e9d558DEc99a2E2F81Cf925424ba399492bDc
# Earlier Coston2 set (deploy block 37317124). Unset keeps these defaults, so elections already on
# that set stay readable. Set a value (comma-separated, or empty) only to replace the list.
# LEGACY_LEDGER_ADDRESSES=0xF579913c90b86f102Fff8D07c6c16f465495013C
# LEGACY_REGISTRY_ADDRESSES=0x651A078e51B69Eff17e22950573EbE0252f43E63
# LEGACY_VERIFIER_REGISTRY_ADDRESSES=0xdb6A83242139E3b7D47c31588d8d06c64CE94316
# Requests per minute per client (and instance) before 429
# VERIFIER_RATE_PER_MINUTE=240

# Optional Cloudflare image Worker. Leave unset: uploads and fetches stay on Netlify Blobs.
# When set, it must be the Worker's https origin (no path, no credentials). The value is not a secret;
# SCANNER_UPLOAD_TOKEN on the Worker is the secret, set with `wrangler secret put`, not in git.
# R2_IMAGE_SERVICE_URL=

# Public comments are not configured here. They live on the Cloudflare Worker.
# Set these with `wrangler secret put` from apps/beingsvote-site/worker. Never commit a value.
# COMMENT_ADMIN_TOKEN=
# TURNSTILE_SECRET=
# COMMENT_IP_PEPPER=
