{
  "name": "@beings/ledger",
  "version": "0.0.0",
  "private": true,
  "description": "B.E.I.N.G.S. M4: Solidity contracts (ElectionRegistry, BallotLedger, Tally, VerifierRegistry) via Hardhat, target Flare Coston2",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "build": "hardhat compile",
    "pretest": "npm run build -w @beings/core",
    "test": "hardhat test",
    "pregas": "npm run build -w @beings/core",
    "gas": "hardhat run scripts/gas-report.js",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:coston2": "hardhat run scripts/deploy.js --network coston2",
    "smoke:local": "hardhat run scripts/smoke.js",
    "smoke:coston2": "hardhat run scripts/smoke.js --network coston2",
    "election200:local": "hardhat run scripts/election200.js",
    "election200:coston2": "hardhat run scripts/election200.js --network coston2",
    "clean": "hardhat clean",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@beings/core": "*",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "hardhat": "^2.26.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0"
  }
}
