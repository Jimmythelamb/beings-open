{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/beings/election-file.schema.json",
  "title": "B.E.I.N.G.S. election file (draft)",
  "type": "object",
  "required": [
    "schemaVersion",
    "electionCode",
    "version",
    "name",
    "organizerPublicKey",
    "questions",
    "resultRules",
    "privacy",
    "registeredVoters",
    "ballotCodes",
    "approvedAppHashes",
    "quorum",
    "opensAt",
    "closesAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "electionCode": {
      "type": "string",
      "pattern": "^BEINGS-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{6}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": "string",
      "description": "IPFS CID of the previous version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "organizerPublicKey": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "EVM address of the organizer's hardware-wallet key"
    },
    "deviceAddresses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "maxMarks",
          "choices"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q[0-9]{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "maxMarks": {
            "type": "integer",
            "minimum": 1
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^c[0-9]{1,3}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "resultRules": {
      "type": "object",
      "required": [
        "emptyBelow",
        "markedAbove",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "emptyBelow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "score < this = empty"
        },
        "markedAbove": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "score > this = marked"
        },
        "results": {
          "const": [
            "V",
            "B",
            "O",
            "U"
          ]
        },
        "abstainButton": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "consensusThresholds": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. Three fill-score pairs for the consensus re-read of the same scans. A missing pair uses the default: tight emptyBelow 10 / markedAbove 55, standard = this file's resultRules, loose emptyBelow 20 / markedAbove 45. score < emptyBelow is empty; score > markedAbove is marked.",
      "properties": {
        "tight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emptyBelow", "markedAbove"],
          "properties": {
            "emptyBelow": { "type": "integer", "minimum": 0, "maximum": 100 },
            "markedAbove": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emptyBelow", "markedAbove"],
          "properties": {
            "emptyBelow": { "type": "integer", "minimum": 0, "maximum": 100 },
            "markedAbove": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "loose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emptyBelow", "markedAbove"],
          "properties": {
            "emptyBelow": { "type": "integer", "minimum": 0, "maximum": 100 },
            "markedAbove": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "redactImages",
        "publishOrder",
        "timeGranularity",
        "minBreakdownSize"
      ],
      "additionalProperties": false,
      "properties": {
        "redactImages": {
          "type": "boolean"
        },
        "publishOrder": {
          "enum": [
            "sorted",
            "shuffled"
          ]
        },
        "timeGranularity": {
          "enum": [
            "event",
            "day",
            "hour"
          ]
        },
        "minBreakdownSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "imageStore": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "where the redacted images and full record files are kept temporarily; linked to the ledger by SHA-256 only",
      "properties": {
        "type": {
          "enum": [
            "ipfs",
            "image-database",
            "other"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "imageRetention": {
      "type": "object",
      "required": [
        "basis",
        "afterRetention"
      ],
      "additionalProperties": false,
      "description": "optional, set per situation and area; should follow the existing rules for scanned-ballot systems in the jurisdiction",
      "properties": {
        "basis": {
          "enum": [
            "jurisdiction-rules",
            "organizer-policy"
          ]
        },
        "ruleReference": {
          "type": "string",
          "description": "optional pointer to the law or rule followed"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "days images are kept after results are Final; extended while a review, recount or dispute is open"
        },
        "afterRetention": {
          "enum": [
            "delete",
            "officials-hold"
          ]
        }
      }
    },
    "registeredVoters": {
      "type": "integer",
      "minimum": 0,
      "description": "count only, no identities; 0 = no register used (reconcile against the printed count)"
    },
    "ballotCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{12}$"
      },
      "description": "the random ballot codes printed on the ballots and receipts (one per ballot)"
    },
    "layoutHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical JSON (RFC 8785) of the ballot layout file (IC2). Optional in the schema so older files stay valid; the ballot generator (M2) always writes it, so the layout is covered by the election file hash recorded on-chain"
    },
    "approvedAppHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "SHA-256 of each approved scanner-app build"
    },
    "quorum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "opensAt": {
      "type": "string",
      "format": "date-time"
    },
    "closesAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
